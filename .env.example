# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# Use the "Transaction" pooler string for serverless/edge, or the direct string for local dev.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
