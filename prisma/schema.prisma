// Prisma schema — the database is a hosted Postgres instance (Prisma Postgres).
// Auth, sessions, and access control are handled in the app via NextAuth,
// not any database-vendor auth product.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  client
}

enum LeadStatus {
  new
  contacted
  quoted
  won
  lost
}

enum ContractStatus {
  unsigned
  sent
  signed
}

enum PaymentStatus {
  pending
  due_soon
  overdue
  paid
}

enum DeliverableStatus {
  not_started
  in_progress
  ready
  delivered
}

enum TeamRole {
  photographer
  videographer
  editor
  coordinator
  other
}

model User {
  id           String   @id @default(cuid())
  role         Role     @default(client)
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  companyName  String   @default("The Occasions Event Planners")
  // Permission fields — only meaningful for role = admin.
  // isOwner: can manage other admin login accounts and grant/revoke canDelete.
  // canDelete: can delete enquiries, projects, and crew — not just create/edit.
  isOwner      Boolean  @default(false)
  canDelete    Boolean  @default(false)
  createdAt    DateTime @default(now())

  projects       Project[]
  assignedLeads  Lead[]     @relation("AssignedAdmin")
  documents      Document[]

  @@map("users")
}

model Lead {
  id             String     @id @default(cuid())
  fullName       String
  email          String?
  phone          String?
  eventType      String?
  eventDate      DateTime?
  budgetRange    String?
  source         String     @default("landing_page")
  status         LeadStatus @default(new)
  quoteAmount    Decimal?   @db.Decimal(12, 2)
  notes          String?
  assignedAdminId String?
  assignedAdmin  User?      @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  project        Project?

  @@map("leads")
}

model Project {
  id                 String         @id @default(cuid())
  clientId           String?
  client             User?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId             String?        @unique
  lead               Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title              String
  eventType          String         @default("Wedding")
  eventDate          DateTime
  venue              String?
  totalQuote         Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal        @default(0) @db.Decimal(12, 2)
  contractStatus     ContractStatus @default(unsigned)
  galleryItemsTotal  Int            @default(4)
  galleryItemsReady  Int            @default(0)
  coverImageUrl      String?
  shareToken         String?        @unique
  sharePin           String?
  createdAt          DateTime       @default(now())

  installments PaymentInstallment[]
  contract     Contract?
  assignments  ProjectAssignment[]
  schedule     EventScheduleItem[]
  moodboard    MoodboardItem[]
  deliverables Deliverable[]
  documents    Document[]
  automationEvents AutomationEvent[]

  @@map("projects")
}

model PaymentInstallment {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal       @db.Decimal(12, 2)
  dueDate   DateTime
  status    PaymentStatus @default(pending)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@map("payment_installments")
}

model Contract {
  id        String         @id @default(cuid())
  projectId String         @unique
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileUrl   String?
  status    ContractStatus @default(unsigned)
  sentAt    DateTime?
  signedAt  DateTime?
  createdAt DateTime       @default(now())

  @@map("contracts")
}

model TeamMember {
  id        String   @id @default(cuid())
  fullName  String
  role      TeamRole
  email     String?
  phone     String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments  ProjectAssignment[]
  deliverables Deliverable[]

  @@map("team_members")
}

model ProjectAssignment {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  shootLabel   String?
  notified     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@map("project_assignments")
}

model EventScheduleItem {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  eventDate DateTime
  startTime String?
  location  String?
  notes     String?
  sortOrder Int       @default(0)

  @@map("event_schedule_items")
}

model MoodboardItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  @@map("moodboard_items")
}

model Deliverable {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  status          DeliverableStatus  @default(not_started)
  storageLocation String?
  deliveryLink    String?
  editorId        String?
  editor          TeamMember?        @relation(fields: [editorId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  updatedAt       DateTime           @updatedAt

  @@map("deliverables")
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  uploadedById String?
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@map("documents")
}

model AutomationEvent {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel   String
  template  String
  status    String   @default("sent")
  sentAt    DateTime @default(now())

  @@map("automation_events")
}

// Singleton row (id is always 1) holding the public enquiry landing page copy.
model LandingPageSettings {
  id          Int      @id @default(1)
  heading     String   @default("Let's capture your story")
  subheading  String   @default("Fill in your details and we'll get back to you within 24 hours.")
  coverImageUrl String?
  updatedAt   DateTime @updatedAt

  @@map("landing_page_settings")
}
